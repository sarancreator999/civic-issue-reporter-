# --- GENERAL APPLICATION CONFIGURATION ---
FLASK_APP=app.py
FLASK_ENV=development

# --- DATABASE CONFIGURATION ---
# Use a secure path for production, e.g., a PostgreSQL connection string.
# Example using local SQLite (simple demo):
DATABASE_URL=sqlite:///civiccare.db
SECRET_KEY="YOUR_SUPER_SECURE_SECRET_KEY"

# --- ESCALATION TIMERS (in hours) ---
# Time before escalating from Local Officer to District Officer
ESCALATION_TIMER_1_HOURS=48
# Time before escalating from District Officer to Media/NGOs
ESCALATION_TIMER_2_HOURS=96

# --- EXTERNAL SERVICE CREDENTIALS (MOCK/EXAMPLE) ---

# 1. Email Service (e.g., SendGrid, AWS SES)
# These credentials would be used in the `send_notification` function.
EMAIL_API_KEY="sg.YOUR_SENDGRID_API_KEY"
FROM_EMAIL="reports@civiccare.in"

# 2. WhatsApp/SMS Service (e.g., Twilio)
# Used for sending WhatsApp/SMS notifications to officers.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# 3. Geo-Mapping Service (Optional, for more precise officer lookups)
# NOMINATIM does not require a key, but commercial services might.
# MAPS_API_KEY="your_maps_geocoding_key"